{
  "expo": {
    "name": "InvestoGenie",
    "slug": "investogenie",
    "version": "0.1.1",
    "description": "Private InvestoGenie market terminal and trade ledger companion.",
    "orientation": "portrait",
    "scheme": "investogenie",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.investogenie.mobile",
      "buildNumber": "2",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.investogenie.mobile",
      "versionCode": 2,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow InvestoGenie to protect your signed-in session."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow InvestoGenie to protect your signed-in session."
        }
      ],
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "7799dd9d-5a04-4266-9ec5-c41265f1c0df"
      }
    }
  }
}
