{
  "expo": {
    "name": "InvestoGenie",
    "slug": "investogenie",
    "version": "0.1.0",
    "description": "Private InvestoGenie market terminal and trade ledger companion.",
    "orientation": "portrait",
    "scheme": "investogenie",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.investogenie.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.investogenie.mobile",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow InvestoGenie to protect your signed-in session."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow InvestoGenie to protect your signed-in session."
        }
      ],
      "expo-notifications"
    ]
  }
}
