{
  "name": "investogenie-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "validate:release": "node scripts/validate-release.mjs",
    "prebuild": "expo prebuild --clean",
    "build:android:release": "npm run validate:release && expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease",
    "build:ios:release": "npm run validate:release && LANG=en_US.UTF-8 expo prebuild --platform ios --clean && expo run:ios --configuration Release --no-bundler",
    "test:plugins": "node --test plugins/withSceneLifecycle.test.js"
  },
  "dependencies": {
    "expo": "~57.0.24",
    "expo-constants": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
