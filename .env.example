# Local macOS configuration. Copy to .env.local and replace every placeholder.
DATABASE_URL=postgresql://YOUR_MAC_USER@127.0.0.1:5432/investogenie
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
CRON_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional provider key.
FINANCIAL_API_KEY=

# Optional. Enables the "Forgot password?" reset on the login screen.
# The login page is reachable by anything that can reach the app, so the reset is gated on
# this key rather than being open; with it unset the option is not offered at all.
# Generate with: openssl rand -hex 24   (must be at least 16 characters)
# scripts/reset-local-password.mjs remains the host-access recovery path and needs no key.
PASSWORD_RESET_KEY=

# Base URL used to build links in outgoing email (password reset, daily digest).
# Must be reachable from wherever mail is read; defaults to http://localhost:3000.
NEXT_PUBLIC_APP_URL=
