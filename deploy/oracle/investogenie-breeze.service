[Unit]
Description=InvestoGenie ICICI Breeze live market-data worker
After=network-online.target postgresql.service investogenie.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=investogenie
Group=investogenie
WorkingDirectory=/opt/investogenie/app
EnvironmentFile=/etc/investogenie/investogenie.env
ExecStart=/opt/investogenie/app/.venv/bin/python workers/breeze_market_daemon.py
Restart=on-failure
RestartSec=20
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/investogenie /var/log/investogenie
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
