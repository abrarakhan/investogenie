# Copy to /etc/investogenie/investogenie.env and chmod 600.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
NEXT_PUBLIC_APP_URL=https://investogenie.example.com

DATABASE_URL=postgresql://investogenie:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/investogenie
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
CRON_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Preserve the exact local value when restoring a database that contains
# encrypted user credentials. Changing it makes those stored values unreadable.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_OR_COPY_EXISTING_VALUE

# Optional provider key used by configured financial-data integrations.
FINANCIAL_API_KEY=

# Optional News & AI Swing source. Only one provider key is required.
ALPHA_VANTAGE_API_KEY=
GNEWS_API_KEY=
NEWS_API_KEY=
NEWS_REFRESH_INTERVAL_MINUTES=60

# Preferred deployment-owned model for News & AI Swing classification.
DEEPSEEK_API_KEY=

# Optional read-only Gmail connector. The daily job discovers and processes
# NSDL CAS statements plus unambiguous AMC monthly portfolio disclosures.
# The user's CAS PDF password is encrypted in the database, never stored here.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GMAIL_DISCLOSURE_SYNC_INTERVAL_HOURS=24
GMAIL_DISCLOSURE_SYNC_DISABLED=0

PYTHON_BIN=/opt/investogenie/app/.venv/bin/python

# Conservative defaults for the 2-OCPU Always Free VM. Increase only after
# observing CPU, memory, and provider throttling.
FUNDAMENTALS_SYNC_LIMIT=100
US_FUNDAMENTALS_LIMIT=100
US_HISTORY_LIMIT=75
US_QUOTE_LIMIT=1000
MARKET_REFRESH_INTERVAL_MINUTES=60
MARKET_HOURS_QUOTE_REFRESH_INTERVAL_MINUTES=15
INDIA_LIVE_QUOTE_BATCH_SIZE=100
INDIA_LIVE_QUOTE_SLEEP_SECONDS=0.2

# Optional ICICI Breeze primary feed for priority stocks. The worker waits for
# encrypted credentials entered in Settings. Yahoo/Google remain the 15-minute
# fallback and official Bhavcopy remains the end-of-day authority.
BREEZE_API_KEY=
BREEZE_API_SECRET=
BREEZE_SESSION_TOKEN=
BREEZE_CASH_EXCHANGES=NSE,BSE
BREEZE_CASH_LIMIT=750
BREEZE_SUBSCRIBE_BATCH_SIZE=100
BREEZE_DB_FLUSH_SECONDS=3
BREEZE_DB_MAX_BATCH=500
