# Copy to /etc/investogenie/investogenie.env and chmod 600.
NODE_ENV=production
HOSTNAME=127.0.0.1
PORT=3000
NEXT_PUBLIC_APP_URL=https://investogenie.example.com

DATABASE_URL=postgresql://investogenie:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/investogenie
SESSION_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32
CRON_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_32

# Preserve the exact local value when restoring a database that contains
# encrypted user credentials. Changing it makes those stored values unreadable.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_OR_COPY_EXISTING_VALUE

# Optional provider key used by configured financial-data integrations.
FINANCIAL_API_KEY=

PYTHON_BIN=/opt/investogenie/app/.venv/bin/python

# Conservative defaults for the 2-OCPU Always Free VM. Increase only after
# observing CPU, memory, and provider throttling.
FUNDAMENTALS_SYNC_LIMIT=100
US_FUNDAMENTALS_LIMIT=100
US_HISTORY_LIMIT=75
US_QUOTE_LIMIT=1000
MARKET_REFRESH_INTERVAL_MINUTES=60
INDIA_MARKET_QUOTE_REFRESH_INTERVAL_MINUTES=15
