# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
__pycache__/
*.py[cod]

# obsolete local Supabase CLI state (the app uses direct PostgreSQL)
/supabase/

# local worker logs
/logs/
# The Breeze SDK writes apiLogs.log into whatever directory it is run from, so a
# pipeline or worker invoked from its own folder leaves an untracked logs/ there —
# which the deploy script then refuses to deploy over. Unanchored, so it is caught
# wherever the SDK drops it.
logs/
.runtime-india-market-holidays.json

# local AI/session state and editor configuration
/.claude/context/
/opencode.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
